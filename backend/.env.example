# Copy to .env and fill in. NEVER commit .env.
# DeepSeek is the default provider: reachable directly from Hong Kong and
# vision-capable since 2026-08. Legacy model names (e.g. `deepseek-chat`) are
# discontinued — use the explicit V4 ids below.
SKINCOACH_LLM_PROVIDER=deepseek
SKINCOACH_DEEPSEEK_API_KEY=
SKINCOACH_ANTHROPIC_API_KEY=
SKINCOACH_OPENAI_API_KEY=

# DeepSeek V4 model tiering: photo analysis uses the vision model, advice /
# memory tasks use the plain text model.
SKINCOACH_DEEPSEEK_TEXT_MODEL=deepseek-v4-flash
SKINCOACH_DEEPSEEK_VISION_MODEL=deepseek-v4-flash-vision-exp

# Model names for other providers (only used when that key is set).
SKINCOACH_ANTHROPIC_MODEL=claude-sonnet-5
SKINCOACH_OPENAI_MODEL=gpt-5

# Privacy consent default for NEW conversations. Product default is false
# (photos never leave the machine unless the user opts in per conversation);
# a self-hoster who has consented can set true so every new conversation starts
# in cloud-analysis mode. The per-conversation 本地/雲 toggle still applies.
SKINCOACH_CLOUD_ANALYSIS_DEFAULT=false

SKINCOACH_DATABASE_URL=sqlite:///./data/skincoach.db

# ---- observability / debugging ----
# App-module log level（vision 失敗、tool 錯誤、embedder fallback 都會出 log）。
SKINCOACH_LOG_LEVEL=INFO
# fastembed 嘅 model cache 位置。留空 = library 預設（temp dir，macOS 會清 →
# 之後會靜靜降級去 128 維 hash embedder）。指去 data dir 就唔會再重新 download。
SKINCOACH_EMBEDDER_CACHE_DIR=./data/.fastembed-cache
# 每次 consult 追加一行 JSON 落 local file（debug 用；入面冇相、冇 key）。
SKINCOACH_RUN_LOG_ENABLED=true
SKINCOACH_RUN_LOG_PATH=./data/runs.jsonl
